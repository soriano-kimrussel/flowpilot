# FlowPilot AI environment configuration
# Copy to .env.local and fill in values. NEVER commit .env.local.

# --- Required: Supabase (Project Settings -> API Keys) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public base URL of the app, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: server-only elevated access -----------------------------------
# Secret key (sb_secret_...). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Only used to process queued webhook/scheduled jobs when no user session exists.
# Leave empty to run fully without it (queued jobs are then processed from the dashboard).
SUPABASE_SECRET_KEY=

# Shared secret that protects /api/cron/process-jobs (Vercel Cron sends it as a Bearer token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Optional: AI provider ---------------------------------------------------
# demo   = deterministic rule-based processing (default, no network, no key)
# ollama = local Ollama server (development only)
# api    = OpenAI-compatible chat completions API you configured yourself (free tier)
AI_PROVIDER=demo

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

AI_API_BASE_URL=
AI_API_KEY=
AI_API_MODEL=

# Request timeout for real AI providers, in milliseconds.
AI_TIMEOUT_MS=15000

# --- Optional: tests (use a dedicated TEST project, never production) ----------
# TEST_SUPABASE_URL=
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_SUPABASE_SECRET_KEY=
# E2E_BASE_URL=
# E2E_EMAIL=
# E2E_PASSWORD=
